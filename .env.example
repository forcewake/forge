# GitLab
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_WEBHOOK_SECRET=change-me-to-a-random-string
FORGE_BOT_USERNAME=forge-bot

# Database
# SQLite (default)
DATABASE_URL=sqlite+aiosqlite:///./data/forge.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/forge
# MySQL:
# DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/forge

# LiteLLM Proxy
LITELLM_URL=http://litellm:4000

# Model API Keys (used by LiteLLM)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Redis (optional)
# REDIS_URL=redis://redis:6379/0

# MCP Server (optional — bearer token for MCP clients)
# FORGE_MCP_KEY=your-mcp-api-key-here
# Scoped principals (JSON token -> scope list; scopes: forge:read,
# forge:runs:write, forge:approvals:write, forge:admin; "*" = all).
# FORGE_MCP_SCOPED_TOKENS={"ci-bot-token": ["forge:read"]}
# Repository-target allowlist for scoped MCP principals (R19): JSON token
# (or its audit label "tok-<hash>") → list of fnmatch patterns matched
# against the caller-supplied project path. Empty list = deny every target.
# Unset (default) leaves scoped tokens unrestricted; the FORGE_MCP_KEY
# master is unrestricted by design.
# FORGE_MCP_TOKEN_REPOS={"tok-abc123": ["group/app-*"]}
# Public host(s) behind a proxy (comma-separated) — empty keeps the SDK's
# localhost-only Host validation, which 421s proxied requests.
# FORGE_MCP_ALLOWED_HOSTS=forge.example.com

# Forge Behavior
FORGE_MENTION_PATTERN=@forge
LOG_LEVEL=INFO

# Agno
AGNO_TELEMETRY=false

# M1 durable run loop
# Comma-separated GitLab usernames allowed to approve a plan with
# `@forge /go <run-id>` (ADR-0009). Empty — nobody may approve.
# Dedicated bot PAT — forge's own voice for comments, commits and MRs.
# Must belong to the FORGE_BOT_USERNAME user; never reuse a human token.
FORGE_BOT_TOKEN=

FORGE_APPROVERS=
# Target branch for forge Draft MRs and the snapshot base.
FORGE_TARGET_BRANCH=main
# Max seconds a run may wait for CI before the reconciler blocks it.
FORGE_CI_WAIT_SECONDS=3600
# ADR-0008 quality contract: comma-separated CI job names that must exist AND
# succeed before a run becomes ready_for_human. Skipped/manual/missing
# required jobs fail the contract even when the pipeline is green.
# Empty — pipeline success alone is enough.
FORGE_REQUIRED_JOBS=
# ADR-0004: max commit cycles per run — the initial candidate plus (N-1)
# bounded code repairs. Infrastructure/config CI failures never consume a
# cycle (they block the run instead of triggering an LLM repair).
FORGE_MAX_COMMIT_CYCLES=3

# Verification wait (R02): a just-opened PR's checks need a few seconds to
# register; before this grace elapses the verifier keeps waiting instead of
# concluding "no CI configured" (live-found race on the dogfood cycle).
FORGE_VERIFICATION_GRACE_SECONDS=120

# Auto-revive (Tier 1): how many times a run killed by a TRANSIENT failure
# (dispatch 5xx / network / timeout, rate limit, runner startup) may be
# re-dispatched on the SAME branch by the reconciler before it parks
# blocked for a human. 0 disables auto-revive. Fatal failures (config
# errors, driver quality signals, exhausted cycles) never auto-retry.
FORGE_RUN_AUTO_REVIVE_LIMIT=2
# Base of the auto-revive backoff ladder (60s → 120s → 240s …, capped at
# 900s) — the worker-free wait between a transient death and its
# reconciler re-dispatch.
FORGE_RUN_REVIVE_BACKOFF_SECONDS=60

# ADR-0015: implementer backend — "builtin" (LLM -> ChangeSet -> Commits API)
# or "ci_harness" ("ci_harness:claude-code"). The harness executes as a job in
# the TARGET project's CI (see docs/harnesses/onboarding.md); forge never runs
# it locally. Harness API keys stay in project CI variables, never here.
FORGE_IMPLEMENTER_BACKEND=builtin
# Run-level wall-clock budget for a harness job (GitLab maximum_timeout is
# the first line of defence; this durable deadline is the second).
FORGE_HARNESS_TIMEOUT_SECONDS=1800
# R17 liveness: bounded discovery for a dispatch whose response was lost.
# After this many discovery ticks that never found the run, the run parks
# blocked ("dispatch never observed") instead of retrying until the harness
# timeout on a stalled API.
FORGE_HARNESS_DISCOVERY_MAX_ATTEMPTS=20
# Model passed to the harness job as FORGE_HARNESS_MODEL.
FORGE_HARNESS_MODEL=glm-5.3-flash[1m]
# Lane-side (consumed inside the harness job, not by the control plane):
# caps Claude Code's thinking budget on REPAIR re-dispatches only — guided
# fixes carry bounded failure context, and deep per-turn thinking was the
# lane's dominant wall-time cost. First cycles think freely.
# FORGE_MAX_THINKING_TOKENS=8000

# Harness selection (ADR-0023): ordered driver preference; empty = the
# configured backend alone. Dispatch fallback down the chain is OFF here.
# FORGE_HARNESS_PREFERENCE=claude-code,grok-build
# FORGE_HARNESS_FALLBACK=false
# R31 capability manifest: the drivers THIS project onboarded — JSON array
# of driver ids, or {"version": 1, "drivers": [...]}. A driver outside this
# set is never selected, whatever the preference or planner proposes (the
# set CAPS the chain, never extends it). Unset — every shipped driver is
# available. Malformed JSON fails startup (fail closed).
# FORGE_AVAILABLE_DRIVERS=["claude-code","grok-build"]
# R15 per-driver CLI version pins for the Actions harness lane — JSON
# driver → version; "latest" keeps the unpinned npm dist-tag install. The
# LANE falls back to forge's baked-in known-good defaults when unset.
# FORGE_DRIVER_VERSIONS={"claude-code":"2.1.0","grok-build":"latest"}

# MCP servers for harness lanes (ADR-0022): canonical mcpServers JSON;
# secrets go in separate masked CI/pipeline variables referenced as ${VAR}.
# FORGE_HARNESS_MCP={"context7":{"type":"http","url":"https://mcp.context7.com/mcp"}}

# Run budgets (ADR-0018 §5, R13): JSON of named budget profiles — name →
# {"max_calls", "max_tokens", "wallclock_s"} (each optional; omit/null =
# unlimited on that axis). A run's budget class is resolved AT FREEZE TIME
# into numeric ceilings stored in the RunSpec. Unset — no numeric ceilings
# anywhere. Malformed JSON fails startup (fail closed).
# FORGE_BUDGET_PROFILES={"standard":{"max_calls":200,"max_tokens":2000000,"wallclock_s":1800}}

# Write policy (R18): JSON of custom write profiles — name →
# {"denied_paths": [glob], "allowed_paths": [glob],
# "require_special_approval": bool}. Custom profiles extend the base denies
# tighten-only (lockfiles stay denied); built-in names are never shadowed.
# Unset — the four built-in profiles only, default "no_dependencies".
# FORGE_WRITE_PROFILES={"dependency_update":{"allowed_paths":["pyproject.toml","uv.lock"]}}
# Sensitive pipeline entrypoints (R18): JSON project key → pipeline file
# paths, denied under EVERY write profile (a candidate never rewrites its
# own execution lane). Keys are "<provider>:<project_id>" (GitHub also
# accepts "github:<owner/repo>").
# FORGE_PIPELINE_ENTRYPOINTS={"azure_devops:42":["ci/build.yml"]}

# Security findings triage (R25): when true, the /security pass promotes
# its own accepted AI suggestions into the authoritative status WITHOUT a
# human confirm. Default OFF — the AI verdict stays a SUGGESTION.
FORGE_SECURITY_AUTO_ACCEPT=false
# Comma-separated usernames authorized to confirm/reject AI triage
# suggestions. Empty — nobody may confirm (fail closed).
FORGE_SECURITY_TRIAGERS=

# ─── GitHub (ADR-0019/0020) ─────────────────────────────────────────────
# App mode (production): register a GitHub App — docs/getting-started/github.md.
# FORGE_GITHUB_ENABLED=true
# FORGE_GITHUB_WEBHOOK_SECRET=change-me-to-a-random-string
# FORGE_GITHUB_APP_ID=Iv23li...            # client id or numeric app id
# FORGE_GITHUB_PRIVATE_KEY=/secure/path/app.pem   # PEM text or file path
# FORGE_GITHUB_INSTALLATION_ID=161607670
# Lab/PAT fallback (personal use; the token carries your scopes):
# FORGE_GITHUB_TOKEN=
# Harness execution on GitHub Actions (empty = builtin proposer):
# FORGE_GITHUB_HARNESS_WORKFLOW=forge-harness.yml
# Label trigger: /implement equivalent (default "forge"):
# FORGE_TRIGGER_LABEL=forge
# Management API bearer for GET /runs* (empty = open, dev only):
# FORGE_API_READ_TOKEN=
