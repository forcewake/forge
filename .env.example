# GitLab
GITLAB_URL=https://gitlab.example.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_WEBHOOK_SECRET=change-me-to-a-random-string
FORGE_BOT_USERNAME=forge-bot

# Database
# SQLite (default)
DATABASE_URL=sqlite+aiosqlite:///./data/forge.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/forge
# MySQL:
# DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/forge

# LiteLLM Proxy
LITELLM_URL=http://litellm:4000

# Model API Keys (used by LiteLLM)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Redis (optional)
# REDIS_URL=redis://redis:6379/0

# MCP Server (optional — bearer token for MCP clients)
# FORGE_MCP_KEY=your-mcp-api-key-here

# Forge Behavior
FORGE_MENTION_PATTERN=@forge
LOG_LEVEL=INFO

# Agno
AGNO_TELEMETRY=false

# M1 durable run loop
# Comma-separated GitLab usernames allowed to approve a plan with
# `@forge /go <run-id>` (ADR-0009). Empty — nobody may approve.
# Dedicated bot PAT — forge's own voice for comments, commits and MRs.
# Must belong to the FORGE_BOT_USERNAME user; never reuse a human token.
FORGE_BOT_TOKEN=

FORGE_APPROVERS=
# Target branch for forge Draft MRs and the snapshot base.
FORGE_TARGET_BRANCH=main
# Max seconds a run may wait for CI before the reconciler blocks it.
FORGE_CI_WAIT_SECONDS=3600
