# Build context hygiene: never bake local env, caches, or the host venv
# (a macOS .venv copied into the Linux image breaks the interpreter links)
.env
.venv
venv
data/
.git
.gitignore
.dockerignore
.github
docs/
tests/
!tests
tests/*
!tests/fixtures
tests/fixtures/*
!tests/fixtures/litellm
!tests/fixtures/litellm/**
**/__pycache__
**/*.py[cod]
.mypy_cache
.ruff_cache
.pytest_cache
.forge/
.DS_Store
*.db
