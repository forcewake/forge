{
  "$defs": {
    "CheckpointEntry": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "100644",
            "100755",
            "120000"
          ],
          "title": "Mode",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "protocol": {
          "const": "forge.lane/1",
          "default": "forge.lane/1",
          "title": "Protocol",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sha256"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "state": {
          "enum": [
            "new",
            "modified",
            "deleted"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "path",
        "mode",
        "sha256",
        "state",
        "size_bytes"
      ],
      "title": "CheckpointEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approved_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approved Digest",
      "type": "string"
    },
    "attempt": {
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "base_sha": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Base Sha",
      "type": "string"
    },
    "driver": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Driver",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/CheckpointEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "forge_run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Forge Run Id",
      "type": "string"
    },
    "generation": {
      "minimum": 0,
      "title": "Generation",
      "type": "integer"
    },
    "protocol": {
      "const": "forge.lane/1",
      "default": "forge.lane/1",
      "title": "Protocol",
      "type": "string"
    },
    "resume_session": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resume Session"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "forge_run_id",
    "attempt",
    "generation",
    "base_sha",
    "approved_digest",
    "sequence",
    "entries",
    "driver"
  ],
  "title": "CheckpointManifest",
  "type": "object"
}
