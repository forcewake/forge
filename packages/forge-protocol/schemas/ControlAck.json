{
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "checkpoint_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Id"
    },
    "command_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Command Id",
      "type": "string"
    },
    "delivery_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Delivery Id",
      "type": "string"
    },
    "detail": {
      "default": "",
      "title": "Detail",
      "type": "string"
    },
    "forge_run_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[\\w.-]+$",
      "title": "Forge Run Id",
      "type": "string"
    },
    "generation": {
      "minimum": 0,
      "title": "Generation",
      "type": "integer"
    },
    "protocol": {
      "const": "forge.lane/1",
      "default": "forge.lane/1",
      "title": "Protocol",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "status": {
      "enum": [
        "applied",
        "refused"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "forge_run_id",
    "attempt",
    "generation",
    "command_id",
    "sequence",
    "delivery_id",
    "status"
  ],
  "title": "ControlAck",
  "type": "object"
}
