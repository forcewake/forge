      "repository_id": "orders",
      "paths": [
        "**"
      ]
    },
    {
      "repository_id": "billing",
      "paths": [
        "**"
      ]
    }
  ],
  "write_scope": [
    {
      "repository_id": "orders",
      "paths": [
        "src/**",
        "tests/**"
      ]
    }
  ],
  "allowed_effects": [
    "discovery_read",
    "candidate_publication",
    "verification_run"
