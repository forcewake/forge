# The release image installs the wheel already built and tested by release.yml.
FROM docker.io/library/python:3.13-slim
COPY --from=ghcr.io/astral-sh/uv:0.9.29 /uv /bin/uv
WORKDIR /app
ENV PYTHONUNBUFFERED=1 UV_LINK_MODE=copy PATH="/app/.venv/bin:$PATH"
COPY dist /opt/forge/dist
RUN uv venv /app/.venv \
    && uv pip install --python /app/.venv/bin/python --require-hashes -r /opt/forge/dist/runtime-requirements.txt \
    && uv pip install --python /app/.venv/bin/python --no-deps /opt/forge/dist/*.whl
COPY agents /app/agents
COPY alembic /app/alembic
COPY alembic.ini /app/alembic.ini
RUN mkdir -p /app/data && useradd -u 1000 -m forge && chown -R forge:forge /app
USER forge
EXPOSE 8420
CMD ["uvicorn", "forge.main:app", "--host", "0.0.0.0", "--port", "8420"]
